# Used by `next build` / `next start` only (npm run dev keeps using localhost).
# NEXT_PUBLIC_* values are baked into the build — rebuild after changing them. No secrets here.
#
# Decision 56 — ClinicQ runs on clinicq.fit AND clinicq.in at once, each with:
#   <root>            main site (marketing, doctor search, staff login)
#   patient.<root>    the patient site (every intake, live token, patient login)
#   <clinic>.<root>   the clinic's own home page + staff login without a clinic code
#   api.<root>        the backend (one server)
# A visitor stays on the root they arrived on. The FIRST root is primary: legacy hosts, WhatsApp
# links and Google canonicals use it.

# Backend for server-side renders and pages on no known root; browsers call api.<their root>.
NEXT_PUBLIC_API_BASE_URL=https://api.clinicq.fit
NEXT_PUBLIC_API_SUBDOMAIN=api

NEXT_PUBLIC_ROOT_DOMAINS=clinicq.fit,clinicq.in
NEXT_PUBLIC_SITE_URL=https://clinicq.fit
NEXT_PUBLIC_PATIENT_SITE_URL=https://patient.clinicq.fit

# Old hosts: only /q/<code> (printed QR codes) and /token-image are served there; everything else
# moves to clinicq.fit.
NEXT_PUBLIC_LEGACY_HOSTS=clinicq.praispranav.com,medqr.praispranav.com,patient.praispranav.com

# The address printed on new QR standees (<this>/q/<code>). Kept on the old host on purpose: codes
# already printed use it, and it forwards to the patient site.
NEXT_PUBLIC_PATIENT_BASE_URL=https://clinicq.praispranav.com
