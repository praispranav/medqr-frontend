# Used by `next build` / `next start` only (npm run dev keeps using localhost).
# NEXT_PUBLIC_* values are baked into the build — rebuild after changing them. No secrets here.

# Backend API (NestJS) — the one shared API behind every live frontend domain
NEXT_PUBLIC_API_BASE_URL=https://medqrapi.praispranav.com

# This app's own public address. Admin-list QR standees now encode <this>/q/<code> (the page calls
# the API and decides client-side where to go) instead of the backend redirecting — keeps printed
# codes domain-correct automatically, including once a second production domain is added. Also what
# clinic QRs printed from the doctor portal point at (/patient/<clinic>).
# NEXT_PUBLIC_QR_BASE_URL is no longer read — QrPoster.tsx now always uses this var.
NEXT_PUBLIC_PATIENT_BASE_URL=https://medqr.praispranav.com

# Per-clinic subdomains are OFF for this deployment (clinic pages live at /patient/<clinic>).
# Leave NEXT_PUBLIC_ROOT_DOMAIN unset — setting it to praispranav.com would make "medqr" look like a clinic.
